# Web application
APP_PORT=3000
NEXT_PUBLIC_APP_NAME=KeepSpot

# Supabase public configuration. These values are included in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Supabase key, used by reminder cron.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Angus adapter
# mock: test the manual-entry flow without an external recognition service
# generic-json: POST a signed image URL to a custom Angus wrapper
# angus-rest: Angus multipart + Basic Auth job style
ANGUS_API_MODE=mock
ANGUS_API_URL=https://gate.angus.ai
ANGUS_CLIENT_ID=
ANGUS_CLIENT_SECRET=
ANGUS_SERVICE_NAME=
ANGUS_SERVICE_VERSION=1

# Reminder endpoint authentication. Use a long random value.
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Lightweight scheduler container
# It calls /api/cron/reminders at this interval. One hour is sufficient because
# the API calculates each user's local date and prevents duplicate reminders.
CRON_INTERVAL_MINUTES=60
RUN_CRON_ON_START=true

# Email notifications
# Keep true until Resend and the sending domain are configured.
REMINDER_DRY_RUN=true
RESEND_API_KEY=
REMINDER_FROM_EMAIL="KeepSpot <reminders@example.com>"
