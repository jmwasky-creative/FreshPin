# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only service role key, used by the reminder cron only
SUPABASE_SERVICE_ROLE_KEY=

# Angus adapter
# mock: returns a safe empty draft so the manual flow can be tested
# generic-json: POSTs a signed image URL as JSON to ANGUS_API_URL
# angus-rest: uses the documented Angus multipart + Basic Auth job style
ANGUS_API_MODE=mock
ANGUS_API_URL=https://gate.angus.ai
ANGUS_CLIENT_ID=
ANGUS_CLIENT_SECRET=
ANGUS_SERVICE_NAME=
ANGUS_SERVICE_VERSION=1

# Vercel Cron authentication
CRON_SECRET=

# Email notifications
RESEND_API_KEY=
REMINDER_FROM_EMAIL="KeepSpot <reminders@example.com>"
REMINDER_DRY_RUN=true

# Optional product text
NEXT_PUBLIC_APP_NAME=KeepSpot
